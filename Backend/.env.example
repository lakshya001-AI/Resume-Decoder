# Copy this file to Backend/.env and fill in the real values.
# Backend/.env is gitignored — never commit real credentials.

# --- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=trueOffer_ai_DB

# --- Sessions --------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
JWT_SECRET=
ACCESS_TOKEN_TTL_DAYS=7
# How long an emailed reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=30

# --- URLs ------------------------------------------------------------------
# Public base URL of this API. Must match the redirect URI registered with
# Google, exactly — scheme, host and port included.
BACKEND_URL=http://127.0.0.1:8000
# Where the browser is sent back to after a social login.
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call this API (comma-separated).
FRONTEND_ORIGINS=

# --- Google ----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI:
#   http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (password reset) -------------------------------------------------
# Leave SMTP_HOST empty in development: reset links are then written to the
# uvicorn log instead of being emailed, which is enough to test the flow.
# For Gmail: host smtp.gmail.com, port 587, and an App Password from
# myaccount.google.com/apppasswords (requires 2FA) — NOT your account password.
# Gmail rewrites a From that isn't the authenticated account, so keep SMTP_FROM
# on the same address as SMTP_USER.
APP_NAME=TrueOffer.AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TrueOffer.AI <no-reply@trueoffer.ai>
SMTP_STARTTLS=true
