# Copy this file to Backend/.env and fill in the real values.
# Backend/.env is gitignored — never commit real credentials.

# --- MongoDB ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=trueOffer_ai_DB
# Delete stored offer-letter reports after this many days. 0 keeps them forever.
# Changing it later needs the existing `audit_ttl` index dropped by hand — Mongo
# will not alter expireAfterSeconds on an index that already exists.
AUDIT_RETENTION_DAYS=0

# --- Offer-letter analysis --------------------------------------------------
# aistudio.google.com -> Get API key. Without this, POST /api/upload returns 503
# and the rest of the API carries on working.
GEMINI_API_KEY=
# Measured, not guessed: this model returned all 38 clauses with no unverifiable
# quotes on a test offer letter. Re-test before changing it.
GEMINI_MODEL=gemini-3.6-flash
# Headroom for 38 clauses plus thinking tokens, which count against this.
GEMINI_MAX_TOKENS=32000
# A long read of a long document — bounded so a stuck request eventually fails.
GEMINI_TIMEOUT_SECONDS=240
# Largest PDF accepted. The upload page enforces the same number in the browser.
MAX_UPLOAD_MB=10
# Placeholder until billing exists: every report is unlocked at this price.
REPORT_PLAN=full
REPORT_PRICE=0

# --- Sessions --------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
JWT_SECRET=
ACCESS_TOKEN_TTL_DAYS=7
# How long an emailed reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=30

# --- URLs ------------------------------------------------------------------
# Public base URL of this API. Must match the redirect URI registered with
# Google, exactly — scheme, host and port included.
BACKEND_URL=http://127.0.0.1:8000
# Where the browser is sent back to after a social login.
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call this API (comma-separated).
FRONTEND_ORIGINS=

# --- Google ----------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorised redirect URI:
#   http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (password reset) -------------------------------------------------
# Leave SMTP_HOST empty in development: reset links are then written to the
# uvicorn log instead of being emailed, which is enough to test the flow.
# For Gmail: host smtp.gmail.com, port 587, and an App Password from
# myaccount.google.com/apppasswords (requires 2FA) — NOT your account password.
# Gmail rewrites a From that isn't the authenticated account, so keep SMTP_FROM
# on the same address as SMTP_USER.
APP_NAME=TrueOffer.AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TrueOffer.AI <no-reply@trueoffer.ai>
SMTP_STARTTLS=true
